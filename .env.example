VITE_API_BASE_URL=http://127.0.0.1:3001
# Production builds use the public Render URL in .env.production.
# Never add DATABASE_URL or JWT signing secrets to this desktop project.
# Optional local Korean transcription for the fixed portfolio command.
# Run node scripts/setup-local-stt.mjs first.
# Use cloud for the authenticated NestJS -> Modal voice path.
VITE_VOICE_MODE=cloud
# Set local-portfolio only when intentionally testing the offline demo.
