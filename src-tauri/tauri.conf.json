{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACE",
  "version": "0.1.0",
  "identifier": "com.ace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ACE",
        "center": true,
        "width": 1080,
        "height": 720,
        "minWidth": 600,
        "minHeight": 500,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:3001"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "icons/icon.ico": "ace-taskbar.ico"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
